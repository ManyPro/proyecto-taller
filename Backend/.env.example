# Copia a Backend/.env en desarrollo local. No pongas claves reales aquí ni en el chat.
# En Docker, las mismas variables van en /.env o /.env.dev de la raíz del repo.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
DIAGNOSIS_MAX_TOKENS_PER_CASE=180000
DIAGNOSIS_MAX_TURNS_PER_CASE=40
DIAGNOSIS_MAX_TURNS_PER_COMPANY_DAY=80

# Gmail OAuth (solo lectura). Pega Client ID y Secret localmente; no los subas ni los pegues en el chat.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# URL del frontend a la que Google redirige después del OAuth
FRONTEND_BASE_URL=http://localhost:5173
