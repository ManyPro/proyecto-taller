# Copia a Backend/.env en desarrollo local. No pongas claves reales aquí ni en el chat.
# En Docker, las mismas variables van en /.env o /.env.dev de la raíz del repo.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
DIAGNOSIS_MAX_TOKENS_PER_CASE=180000
DIAGNOSIS_MAX_TURNS_PER_CASE=40
DIAGNOSIS_MAX_TURNS_PER_COMPANY_DAY=80
