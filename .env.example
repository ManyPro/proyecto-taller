# Copia este archivo a .env (producción) o .env.dev (desarrollo).
# Nunca subas claves reales al repositorio ni las pegues en el chat.

MONGODB_URI=
MONGODB_DB=taller
JWT_SECRET=
ALLOWED_ORIGINS=
PORT=3000

# OpenAI — solo backend. El navegador nunca debe ver estas variables.
# Crea la clave en https://platform.openai.com/api-keys (proyecto de API, no ChatGPT Plus).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000

# Límites de Diagnóstico Renault IA (aplicados por el backend)
DIAGNOSIS_MAX_TOKENS_PER_CASE=180000
DIAGNOSIS_MAX_TURNS_PER_CASE=40
DIAGNOSIS_MAX_TURNS_PER_COMPANY_DAY=80
